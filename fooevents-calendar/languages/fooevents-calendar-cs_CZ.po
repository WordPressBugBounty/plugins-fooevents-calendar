#: templates/eventbrite-options.php:13 templates/eventmetabox.php:222
msgid "Add event to Eventbrite"
msgstr "Přidat událost do Eventbrite"

#: templates/eventbrite-options.php:15 templates/eventmetabox.php:224
msgid "Checking this option will submit the event to Eventbrite."
msgstr "Zaškrtnutím této možnosti odešlete událost do Eventbrite."

#: templates/eventmetabox.php:14
msgid "Is this post an event?"
msgstr "Je tento příspěvek událostí?"

#: templates/eventmetabox.php:16
msgid "No"
msgstr "Ne"

#: templates/eventmetabox.php:17
msgid "Yes"
msgstr "Ano"

#: templates/eventmetabox.php:19
msgid "This option enables event and ticketing functionality."
msgstr "Tato možnost povoluje funkce událostí a vstupenek."

#: templates/eventmetabox.php:26
msgid "Number of days:"
msgstr "Počet dní:"

#: templates/eventmetabox.php:32
msgid "Select the number of days for multi-day events. This setting is used by the Event Check-ins apps to manage daily check-ins."
msgstr "Vyberte počet dní pro vícedenní události. Toto nastavení používají aplikace Event Check-ins ke správě denních check-inů."

#: templates/eventmetabox.php:37
msgid "Event type:"
msgstr "Typ události:"

#: templates/eventmetabox.php:40
msgid "Single"
msgstr "Jednodenní"

#: templates/eventmetabox.php:41
msgid "Sequential days"
msgstr "Po sobě jdoucí dny"

#: templates/eventmetabox.php:42
msgid "Specific days"
msgstr "Konkrétní dny"

#: templates/eventmetabox.php:43
msgid "Select the type of multi-day event. 'Sequential' means the days are in consecutive order whereas 'Select' allows you to choose the exact days."
msgstr "Vyberte typ vícedenní akce. „Postupně“ znamená, že dny jsou v po sobě jdoucím pořadí, zatímco „Vybrat“ vám umožňuje vybrat přesné dny."

#: templates/eventmetabox.php:61 templates/eventmetabox.php:135
msgid "Start time:"
msgstr "Čas zahájení:"

#: templates/eventmetabox.php:81 templates/eventmetabox.php:158
msgid "End time:"
msgstr "Čas ukončení:"

#: templates/eventmetabox.php:108
msgid "Set start/end times globally?"
msgstr "Nastavit globálně časy začátku/konce?"

#: templates/eventmetabox.php:110
msgid "Enable this option to use the same start and end times for each day of a multi-day event."
msgstr "Povolte tuto možnost, chcete-li pro každý den vícedenní události použít stejné časy zahájení a ukončení."

#: templates/eventmetabox.php:118
msgid "Start date:"
msgstr "Datum zahájení:"

#: templates/eventmetabox.php:120
msgid "The date that the event is scheduled to take place. This is used as a label on your website and it's also used by the FooEvents Calendar to display the event."
msgstr "Datum, kdy se má událost konat. Používá se jako štítek na vašem webu a také jej používá kalendář FooEvents k zobrazení události."

#: templates/eventmetabox.php:126
msgid "End date:"
msgstr "Datum ukončení:"

#: templates/eventmetabox.php:128
msgid "The date that the event is scheduled to end. This is used as a label on your website and it's also used by the FooEvents Calendar to display a multi-day event."
msgstr "Datum plánovaného ukončení akce. Používá se jako štítek na vašem webu a také jej používá kalendář FooEvents k zobrazení vícedenní události."

#: templates/eventmetabox.php:153
msgid "The time that the event is scheduled to start."
msgstr "Čas, kdy je naplánováno zahájení události."

#: templates/eventmetabox.php:176
msgid "The time that the event is scheduled to end"
msgstr "Čas, kdy má  událost končit."

#: templates/eventmetabox.php:181
msgid "Time zone:"
msgstr "Časové pásmo:"

#: templates/eventmetabox.php:202
msgid "The time zone where the event is taking place."
msgstr "Časové pásmo, ve kterém se událost koná."

#: templates/eventmetabox.php:207
msgid "Calendar background color:"
msgstr "Barva pozadí kalendáře:"

#: templates/eventmetabox.php:209
msgid "Color of the calendar background for the event. Also changes the background color of the date icon in the FooEvents Check-ins app."
msgstr "Barva pozadí kalendáře pro událost. Také změní barvu pozadí ikony data v aplikaci FooEvents Check-ins."

#: templates/eventmetabox.php:214
msgid "Calendar text color:"
msgstr "Barva textu kalendáře:"

#: templates/eventmetabox.php:216
msgid "Color of the calendar text for the event. Also changes the font color of the date icon in the FooEvents Check-ins app."
msgstr "Barva textu kalendáře pro událost. Také mění barvu písma ikony data v aplikaci FooEvents Check-ins."

